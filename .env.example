# ClawBots Docker Infrastructure - Environment Variables
# Copy this file to .env and update the values for your system

# === User UID/GID (match host user) ===
UID=1000
GID=1000

# === SearXNG ===
SEARXNG_PORT=5321

# === Whisper STT (speaches/faster-whisper) ===
WHISPER_PORT=9001
WHISPER_MODEL=ggml-small
WHISPER_CPU_THREADS=4

# === Piper TTS ===
TTS_PORT=5000
TTS_VOICE_EN=en_GB-alan-medium
TTS_VOICE_HI=hi_IN-priyamvada-medium

# === Timezone ===
TZ=Europe/Berlin
