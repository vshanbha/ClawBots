# ClawBots Docker Infrastructure - Environment Variables
# Copy this file to .env and update the values for your system

# === SearXNG ===
SEARXNG_CONFIG=/path/to/your/SearXNG
SEARXNG_PORT=5321

# === Whisper STT ===
WHISPER_MODELS=/path/to/your/whisper/models
WHISPER_MODEL=small
WHISPER_PORT=9001

# === Piper TTS ===
PIPER_DATA=/path/to/your/piper/data
TTS_PORT=5000
TTS_VOICE_EN=en_GB-alan-medium
TTS_VOICE_HI=hi_IN-priyamvada-medium

# === Timezone ===
TZ=Europe/Berlin

# === ClawBots bind mounts ===
ZEROCLOW_DATA=/path/to/your/.zeroclaw
WORKSPACE_PATH=/path/to/your/workspace
